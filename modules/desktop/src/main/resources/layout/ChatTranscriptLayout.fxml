<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Live transcript - the chat itself, laid out like a chat client. Drawn with ordinary controls
     rather than a browser view: javafx-web would carry WebKit natives, and this feature has to add
     no meaningful install size. -->
<BorderPane maxHeight="Infinity" maxWidth="Infinity" styleClass="chat-root"
            stylesheets="@chat.css"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <!-- Two rows, and every control pinned to its preferred width. One row let the HBox
             shrink its children below their own text, and JavaFX answers that by drawing an
             ellipsis, so at the window size this panel is actually used at every button read as
             three dots. Wrapping is the fix rather than a smaller font, because the truncation
             returns at the next width down. -->
        <VBox spacing="6" style="-fx-padding: 10 16 8 16;">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <!-- Channels are separate conversations, and reading them interleaved is the main
                     reason the transcript was hard to follow. There is no combined view: one feed
                     mixing world chatter into an alliance conversation is the thing the tabs exist
                     to undo. Alliance opens first because it is the one worth reading. -->
                <ToggleButton fx:id="tabWorld" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" styleClass="action-button-timeline"
                              text="World" userData="world" />
                <ToggleButton fx:id="tabAlliance" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" selected="true"
                              styleClass="action-button-timeline"
                              text="Alliance" userData="alliance" />
                <ToggleButton fx:id="tabPersonal" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" styleClass="action-button-timeline"
                              text="Personal" userData="personal" />
                <Separator orientation="VERTICAL" />
                <!-- Which reader's transcript is on screen. The two read the same screens and are
                     stored apart so they can be compared rather than argued about. -->
                <ToggleButton fx:id="tabReaderPython" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectReader" selected="true"
                              styleClass="action-button-timeline" text="Python" userData="SERVICE" />
                <ToggleButton fx:id="tabReaderJava" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectReader" styleClass="action-button-timeline"
                              text="Java" userData="JAVA" />
                <Separator orientation="VERTICAL" />
                <CheckBox fx:id="checkHideChatter" minWidth="-Infinity" mnemonicParsing="false"
                          onAction="#refresh" selected="true" text="Hide game chatter" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#refresh"
                        styleClass="action-button-timeline" text="Refresh" />
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#exportHtml"
                        styleClass="action-button-timeline" text="Export HTML" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="statusLabel" styleClass="label-muted" text="Loading transcript..." />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">
            <VBox fx:id="messageList" spacing="0" style="-fx-padding: 4 8 16 8;" />
        </ScrollPane>
    </center>
</BorderPane>
