<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Live transcript - the chat itself, laid out like a chat client. Drawn with ordinary controls
     rather than a browser view: javafx-web would carry WebKit natives, and this feature has to add
     no meaningful install size. -->
<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <!-- Two rows. One row could not hold four channel toggles, a checkbox, a status line and two
             buttons at this panel width: HBox shrank every control to fit and each one collapsed to
             an ellipsis, so nothing was readable. Controls keep their preferred width (minWidth of
             -Infinity is USE_PREF_SIZE) and the status line, which is the only part that can lose
             characters harmlessly, gets its own row. -->
        <VBox spacing="6" style="-fx-padding: 10 16 8 16;">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <!-- Channels are separate conversations; reading them interleaved is the main reason
                     the transcript was hard to follow. All stays available for a single feed. -->
                <ToggleButton fx:id="tabAll" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" selected="true"
                              styleClass="action-button-timeline" text="All" userData="" />
                <ToggleButton fx:id="tabWorld" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" styleClass="action-button-timeline"
                              text="World" userData="world" />
                <ToggleButton fx:id="tabAlliance" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" styleClass="action-button-timeline"
                              text="Alliance" userData="alliance" />
                <ToggleButton fx:id="tabPersonal" minWidth="-Infinity" mnemonicParsing="false"
                              onAction="#selectChannel" styleClass="action-button-timeline"
                              text="Personal" userData="personal" />

                <Pane HBox.hgrow="ALWAYS" minWidth="0" />

                <CheckBox fx:id="checkHideChatter" minWidth="-Infinity" mnemonicParsing="false"
                          onAction="#refresh" selected="true" text="Hide game chatter" />
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#exportHtml"
                        styleClass="action-button-timeline" text="Export HTML" />
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#refresh"
                        styleClass="action-button-timeline" text="Refresh" />
            </HBox>

            <Label fx:id="statusLabel" styleClass="label-muted" maxWidth="Infinity"
                   text="Loading transcript..." />
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">
            <VBox fx:id="messageList" spacing="0" style="-fx-padding: 4 8 16 8;" />
        </ScrollPane>
    </center>
</BorderPane>
