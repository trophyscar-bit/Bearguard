<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Deal Tracker: the Discord deal channels, one post per tracked item. Posts are data-driven, so they are
     built in code. -->
<HBox stylesheets="@dealtracker.css" styleClass="deal-root" maxHeight="Infinity" maxWidth="Infinity"
      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="deal-sidebar" minWidth="190" prefWidth="190">
        <Label text="DEALS" styleClass="deal-sidebar-title" />
        <VBox fx:id="channelList" spacing="2" VBox.vgrow="ALWAYS" />
        <Label fx:id="labelScanStatus" wrapText="true" styleClass="deal-key" />
        <Button text="Refresh" onAction="#handleRefresh" />
    </VBox>

    <ScrollPane fx:id="postScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="deal-scroll" HBox.hgrow="ALWAYS">
        <VBox fx:id="post" spacing="10" styleClass="deal-post" />
    </ScrollPane>
</HBox>
