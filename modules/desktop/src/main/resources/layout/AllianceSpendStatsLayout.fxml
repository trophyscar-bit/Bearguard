<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.frostguard.app.panel.misc.AllianceSpendStatsController">
    <VBox spacing="12" style="-fx-padding: 0 16 16 16;">

        <VBox styleClass="content-card" spacing="10">
            <HBox maxWidth="Infinity" styleClass="header-yellow">
                <Label text="Alliance spending" />
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 4 4 0 4;">
                <Label styleClass="task-field-label" text="Timeframe" />
                <ComboBox fx:id="comboWindow" prefWidth="160" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRefresh" mnemonicParsing="false" onAction="#handleRefresh"
                        styleClass="action-button-timeline" text="Refresh" />
            </HBox>
            <Label fx:id="lblHeadline" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-padding: 2 0 0 4;" />
            <Label fx:id="lblPeriods" styleClass="label-muted" wrapText="true" style="-fx-padding: 0 4 0 4;" />
            <Label fx:id="lblNote" styleClass="label-muted" wrapText="true" style="-fx-padding: 0 4 4 4;" />
        </VBox>

        <VBox styleClass="content-card" spacing="6">
            <HBox maxWidth="Infinity" styleClass="header-yellow">
                <Label text="By buyer" />
            </HBox>
            <TableView fx:id="tableBuyers" minHeight="180.0" prefHeight="260.0">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colBuyer" prefWidth="220.0" text="Buyer" />
                    <TableColumn fx:id="colBuyerCount" prefWidth="90.0" text="Purchases" />
                    <TableColumn fx:id="colBuyerUsd" prefWidth="110.0" text="Total" />
                    <TableColumn fx:id="colBuyerKnown" prefWidth="120.0" text="Known prices" />
                    <TableColumn fx:id="colBuyerEst" prefWidth="140.0" text="Estimated (by tier)" />
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="content-card" spacing="6">
            <HBox maxWidth="Infinity" styleClass="header-yellow">
                <Label text="Purchases" />
            </HBox>
            <TableView fx:id="tablePurchases" minHeight="240.0" prefHeight="420.0">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colAt" prefWidth="130.0" text="Logged" />
                    <TableColumn fx:id="colWho" prefWidth="150.0" text="Buyer" />
                    <TableColumn fx:id="colPack" prefWidth="230.0" text="Pack" />
                    <TableColumn fx:id="colTier" prefWidth="110.0" text="Gift" />
                    <TableColumn fx:id="colUsd" prefWidth="80.0" text="USD" />
                    <TableColumn fx:id="colSource" prefWidth="110.0" text="Price from" />
                </columns>
            </TableView>
        </VBox>

        <TitledPane fx:id="paneUnpriced" text="Packs without a known price" expanded="false" styleClass="stat-titled-pane">
            <VBox spacing="6">
                <Label styleClass="label-muted" wrapText="true"
                       text="These are priced by gift tier until the deal scan sees them or a price is added to data/alliance-spend/pack-prices.json (pack name to USD)." />
                <Label fx:id="lblUnpriced" wrapText="true" />
            </VBox>
        </TitledPane>
    </VBox>
</ScrollPane>
