<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ToggleSwitch?>
<?import dev.frostguard.app.panel.heroes.Segmented?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Troops > Heroes. Every tab follows one order: header, status, settings, results. Built to bearguard-design/DESIGN-BRIEF.md. -->
<StackPane maxHeight="Infinity" maxWidth="Infinity" stylesheets="@heroes.css"
           HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <TabPane fx:id="tabPane">
        <tabs>
            <Tab text="Hero Gear" closable="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="task-page-scroll">
                    <VBox styleClass="task-page-root" alignment="TOP_LEFT">
                        <VBox styleClass="hero-page" maxWidth="960" spacing="16">

                            <!-- Header -->
                            <HBox alignment="TOP_LEFT" spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="hero-title" text="Hero Gear" />
                                    <Label fx:id="labelStatusLine" styleClass="hero-status-line" wrapText="true" maxWidth="Infinity" />
                                    <Label fx:id="labelLastLine" styleClass="hero-status-line" wrapText="true" maxWidth="Infinity" />
                                    <Label fx:id="labelTonightLine" styleClass="hero-status-line" wrapText="true" maxWidth="Infinity" />
                                </VBox>
                                <VBox alignment="TOP_RIGHT" spacing="4" minWidth="-Infinity">
                                    <Button fx:id="buttonRunNow" mnemonicParsing="false" styleClass="hero-button-primary" minWidth="-Infinity"
                                            text="Run now" onAction="#runNow" />
                                    <Label fx:id="labelRunReason" styleClass="hero-caption" wrapText="true" maxWidth="200" alignment="CENTER_RIGHT" />
                                </VBox>
                            </HBox>

                            <!-- Status: only when the routine has stopped itself. -->
                            <HBox fx:id="boxHalt" styleClass="status-banner" alignment="CENTER_LEFT" spacing="12"
                                  visible="false" managed="false">
                                <Label styleClass="status-banner-icon" text="||" />
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="status-banner-title" text="Gear upgrades are paused" />
                                    <Label fx:id="labelHalt" styleClass="status-banner-text" wrapText="true" maxWidth="Infinity" />
                                </VBox>
                                <Button fx:id="buttonClearHalt" mnemonicParsing="false" styleClass="hero-button-primary" minWidth="-Infinity"
                                        text="Resume upgrades" onAction="#clearHalt" />
                            </HBox>

                            <!-- Settings -->
                            <VBox styleClass="hero-card">
                                <Label styleClass="hero-card-title" text="Settings" />

                                <HBox styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label styleClass="hero-label" text="Run every night" />
                                        <Label fx:id="labelNightlyCaption" styleClass="hero-caption" />
                                    </VBox>
                                    <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                        <ToggleSwitch fx:id="switchNightly" labelPosition="LEFT" />
                                    </HBox>
                                </HBox>

                                <VBox fx:id="boxNightly">
                                    <VBox styleClass="hero-row" spacing="8">
                                        <VBox spacing="4">
                                            <Label styleClass="hero-label" text="Heroes to upgrade" />
                                            <Label fx:id="labelHeroesInfo" styleClass="hero-caption" />
                                        </VBox>
                                        <GridPane fx:id="gridHeroes" styleClass="hero-choices" />
                                        <VBox fx:id="boxHeroesEmpty" styleClass="hero-blank">
                                            <Label styleClass="hero-blank-title" text="No heroes read yet" />
                                            <Label styleClass="hero-blank-text" text="They appear after the first gear check." />
                                        </VBox>
                                    </VBox>

                                    <VBox styleClass="hero-row" spacing="4">
                                        <Label fx:id="labelScope" styleClass="hero-caption" wrapText="true" maxWidth="Infinity" />
                                    </VBox>

                                    <HBox styleClass="hero-row-bare" alignment="CENTER_LEFT" spacing="16">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="hero-label" text="Raise gear levels" />
                                            <Label fx:id="labelEnhanceScope" styleClass="hero-caption" wrapText="true" maxWidth="Infinity" />
                                        </VBox>
                                        <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                            <Segmented fx:id="segmentEnhance" prefWidth="240" minWidth="240" maxWidth="240" />
                                        </HBox>
                                    </HBox>
                                    <HBox fx:id="rowEnhanceAmount" styleClass="hero-row-sub" alignment="CENTER_LEFT" spacing="16">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="hero-label" text="XP items to use" />
                                            <Label fx:id="labelEnhanceReason" styleClass="hero-caption" text="Used when Raise gear levels is For real." />
                                        </VBox>
                                        <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                            <Segmented fx:id="segmentEnhanceAmount" prefWidth="240" minWidth="240" maxWidth="240" />
                                        </HBox>
                                    </HBox>

                                    <VBox styleClass="hero-danger">
                                        <HBox styleClass="hero-row-bare" alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label styleClass="hero-label" text="Forge mastery" />
                                                <Label fx:id="labelForgeScope" styleClass="hero-caption" wrapText="true" maxWidth="Infinity" />
                                            </VBox>
                                            <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                                <Segmented fx:id="segmentForge" prefWidth="240" minWidth="240" maxWidth="240" />
                                            </HBox>
                                        </HBox>
                                        <HBox fx:id="rowForgeAmount" styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label styleClass="hero-label" text="Forges per night" />
                                                <Label fx:id="labelForgeReason" styleClass="hero-caption" text="Used when Forge mastery is For real." />
                                            </VBox>
                                            <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                                <Segmented fx:id="segmentForgeAmount" prefWidth="240" minWidth="240" maxWidth="240" />
                                            </HBox>
                                        </HBox>
                                        <HBox fx:id="rowReserve" styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label styleClass="hero-label" text="Keep stones unspent" />
                                                <Label fx:id="labelReserveReason" styleClass="hero-caption" text="Used when Forge mastery is For real." />
                                            </VBox>
                                            <HBox styleClass="hero-control" alignment="CENTER_RIGHT" spacing="8">
                                                <ComboBox fx:id="comboBoxReserve" prefWidth="240" minWidth="240" />
                                            </HBox>
                                        </HBox>
                                        <HBox styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label styleClass="hero-label" text="Which gear first" />
                                                <Label styleClass="hero-caption" text="Weakest first brings every ticked hero up evenly." />
                                            </VBox>
                                            <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                                <ComboBox fx:id="comboBoxFocus" prefWidth="240" minWidth="240" />
                                            </HBox>
                                        </HBox>
                                    </VBox>

                                    <HBox styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="hero-label" text="Wear best spare gear" />
                                            <Label styleClass="hero-caption" wrapText="true" maxWidth="Infinity"
                                                   text="Puts your best gear on ALL your heroes, not only the ticked ones. Spends nothing." />
                                        </VBox>
                                        <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                            <ToggleSwitch fx:id="switchQuickEquip" labelPosition="LEFT" />
                                        </HBox>
                                    </HBox>

                                    <HBox styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="hero-label" text="Run at" />
                                            <Label styleClass="hero-caption" text="Your local time, every night. It checks your gear first." />
                                        </VBox>
                                        <HBox styleClass="hero-control" alignment="CENTER_RIGHT" spacing="8">
                                            <ComboBox fx:id="comboBoxRunAt" prefWidth="240" minWidth="240" />
                                        </HBox>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Results: what it sees -->
                            <VBox styleClass="hero-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label styleClass="hero-card-title" text="Your gear" />
                                    <Label fx:id="labelGearHelp" styleClass="hero-help" text="(i)" />
                                    <Label fx:id="labelGearInfo" styleClass="hero-card-aside" HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER_RIGHT" />
                                </HBox>
                                <TableView fx:id="tableGear" styleClass="hero-table" />
                                <HBox alignment="CENTER_RIGHT">
                                    <Hyperlink fx:id="linkGear" styleClass="hero-link" onAction="#toggleGear" />
                                </HBox>
                                <VBox fx:id="boxGearEmpty" styleClass="hero-blank">
                                    <Label styleClass="hero-blank-title" text="No gear read yet" />
                                    <Label styleClass="hero-blank-text" text="The first gear check reads every piece on your strongest heroes." />
                                </VBox>
                            </VBox>

                            <VBox styleClass="hero-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label styleClass="hero-card-title" text="What Forge buys next" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Label fx:id="labelStones" styleClass="hero-card-aside" />
                                </HBox>
                                <TableView fx:id="tableUpgrades" styleClass="hero-table" />
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label fx:id="labelUpgradesMore" styleClass="hero-caption" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Hyperlink fx:id="linkUpgrades" styleClass="hero-link" onAction="#toggleUpgrades" />
                                </HBox>
                                <VBox fx:id="boxUpgradesEmpty" styleClass="hero-blank">
                                    <Label fx:id="labelUpgradesEmptyTitle" styleClass="hero-blank-title" />
                                    <Label fx:id="labelUpgradesEmptyText" styleClass="hero-blank-text" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Hero Level Ups" closable="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="task-page-scroll">
                    <VBox styleClass="task-page-root" alignment="TOP_LEFT">
                        <VBox styleClass="hero-page" maxWidth="960" spacing="16">
                            <VBox spacing="4">
                                <Label styleClass="hero-title" text="Hero Level Ups" />
                                <Label fx:id="labelXp" styleClass="hero-status-line" />
                            </VBox>

                            <VBox styleClass="hero-card">
                                <Label styleClass="hero-card-title" text="Settings" />
                                <HBox styleClass="hero-row" alignment="CENTER_LEFT" spacing="16">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label styleClass="hero-label" text="Log a level-up plan" />
                                        <Label styleClass="hero-caption" text="Practice only: writes which hero it would level to the log. Presses nothing." />
                                    </VBox>
                                    <HBox styleClass="hero-control" alignment="CENTER_RIGHT">
                                        <ToggleSwitch fx:id="switchPlan" labelPosition="LEFT" />
                                    </HBox>
                                </HBox>
                                <Label styleClass="hero-caption-footer" text="Hero shards and Ascend are never used, for any hero." />
                            </VBox>

                            <VBox styleClass="hero-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label styleClass="hero-card-title" text="Drill Camp heroes" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Label fx:id="labelLevelsAside" styleClass="hero-card-aside" />
                                </HBox>
                                <TableView fx:id="tableLevels" styleClass="hero-table" />
                                <VBox fx:id="boxLevelsEmpty" styleClass="hero-blank">
                                    <Label fx:id="labelLevelsEmptyTitle" styleClass="hero-blank-title" />
                                    <Label fx:id="labelLevelsEmptyText" styleClass="hero-blank-text" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Rally Joiners" closable="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="task-page-scroll">
                    <VBox styleClass="task-page-root" alignment="TOP_LEFT">
                        <VBox styleClass="hero-page" maxWidth="960" spacing="16">
                            <VBox spacing="4">
                                <Label styleClass="hero-title" text="Rally Joiners" />
                                <Label fx:id="labelJoiners" styleClass="hero-status-line" />
                            </VBox>

                            <VBox styleClass="hero-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label styleClass="hero-card-title" text="Best heroes to send" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Label styleClass="hero-card-aside" text="Higher rally score helps rallies more" />
                                </HBox>
                                <TableView fx:id="tableJoiners" styleClass="hero-table" />
                                <VBox fx:id="boxJoinersEmpty" styleClass="hero-blank">
                                    <Label styleClass="hero-blank-title" text="No squad scan yet" />
                                    <Label styleClass="hero-blank-text" text="Scan on the Squads page to read your heroes." />
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Roster" closable="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="task-page-scroll">
                    <VBox styleClass="task-page-root" alignment="TOP_LEFT">
                        <VBox styleClass="hero-page" maxWidth="960" spacing="16">
                            <VBox spacing="4">
                                <Label styleClass="hero-title" text="Roster" />
                                <Label fx:id="labelRoster" styleClass="hero-status-line" />
                            </VBox>

                            <VBox styleClass="hero-card">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <Label styleClass="hero-card-title" text="All your heroes" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    <Label fx:id="labelRosterAside" styleClass="hero-card-aside" />
                                </HBox>
                                <TableView fx:id="tableHeroes" styleClass="hero-table" />
                                <VBox fx:id="boxRosterEmpty" styleClass="hero-blank">
                                    <Label styleClass="hero-blank-title" text="No squad scan yet" />
                                    <Label styleClass="hero-blank-text" text="Scan on the Squads page to read your heroes." />
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </tabs>
    </TabPane>
</StackPane>
