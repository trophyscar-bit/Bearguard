<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Upcoming Events calendar settings — just the viewer's local timezone for now.
     Scanning itself rides on the bg_telemetry custom task's own schedule, not a toggle here. -->
<StackPane maxHeight="Infinity" maxWidth="Infinity"
           HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="task-page-scroll">
        <VBox spacing="14" styleClass="task-page-root" maxWidth="Infinity">

            <VBox styleClass="content-card">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="header-yellow">
                    <Label text="Upcoming Events Calendar" />
                </HBox>
                <VBox spacing="10" styleClass="task-section-inner">
                    <Label styleClass="task-card-description"
                           text="Controls what timezone the sidebar's Upcoming Events calendar displays its times in. The scans themselves run inside the bg_telemetry custom task."
                           wrapText="true" />
                    <Separator style="-fx-opacity: 0.25;" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label styleClass="task-field-label" text="Local timezone:" />
                        <ComboBox fx:id="comboBoxEventsTimezone" prefWidth="260.0" />
                    </HBox>
                    <Button fx:id="buttonSave" text="Save" onAction="#handleSave" />
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</StackPane>
