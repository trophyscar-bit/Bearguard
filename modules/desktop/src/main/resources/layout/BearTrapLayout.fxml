<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.*?>
<?import dev.frostguard.app.shared.UtcDateTimeEditor?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="task-page-scroll">
            <VBox spacing="16" styleClass="task-page-root" maxWidth="Infinity">

                <VBox styleClass="content-card">
                    <HBox maxWidth="Infinity" styleClass="header-yellow">
                        <CheckBox fx:id="checkBoxEnableBearTrap" mnemonicParsing="false"
                                  style="-fx-font-size: 15px; -fx-font-weight: bold;"
                                  text="Auto bear" />
                    </HBox>
                    <VBox spacing="10" styleClass="task-section-inner">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="90.0" styleClass="task-field-label" text="Lead (min)" />
                            <TextField fx:id="textFieldPreparationTime" prefWidth="100.0" promptText="15" />
                        </HBox>
                        <Label fx:id="labelPreparationTimeError" wrapText="true" />
                        <VBox spacing="4">
                            <Label styleClass="task-field-label" text="Bear start" />
                            <UtcDateTimeEditor fx:id="timerDateTimeEditor" />
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="90.0" styleClass="task-field-label" text="Trap" />
                            <ComboBox fx:id="comboBoxTrapNumber" prefWidth="100.0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="90.0" styleClass="task-field-label" text="Guard" />
                            <ComboBox fx:id="comboBoxGuard" prefWidth="160.0" />
                        </HBox>
                        <CheckBox fx:id="checkBoxIconStart" mnemonicParsing="false" text="Icon start" />
                    </VBox>
                </VBox>

                <HBox alignment="TOP_LEFT" spacing="14">
                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS">
                        <HBox maxWidth="Infinity" styleClass="header-red">
                            <Label text="Squads" />
                        </HBox>
                        <VBox spacing="10" styleClass="task-section-inner">
                            <CheckBox fx:id="checkBoxEnableJoin" mnemonicParsing="false" text="Join rallies" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="90.0" styleClass="task-field-label" text="Hero squads" />
                                <CheckComboBox fx:id="checkComboBoxJoinFlag" prefWidth="120.0" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="90.0" styleClass="task-field-label" text="Troop squads" />
                                <CheckComboBox fx:id="checkComboBoxTroopFlag" prefWidth="120.0" />
                            </HBox>
                            <Label fx:id="labelJoinError" styleClass="setting-validation-message"
                                   text="Pick a Hero squad to join rallies." wrapText="true" />
                            <CheckBox fx:id="checkBoxCallRally" mnemonicParsing="false" text="Own rally" />
                            <HBox fx:id="rowOwnSquad" alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="90.0" styleClass="task-field-label" text="Own squad" />
                                <ComboBox fx:id="comboBoxRallyFlag" prefWidth="100.0" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS">
                        <HBox maxWidth="Infinity" styleClass="header-blue">
                            <Label text="Prep" />
                        </HBox>
                        <VBox spacing="10" styleClass="task-section-inner">
                            <CheckBox fx:id="checkBoxRecallTroops" maxWidth="Infinity"
                                      mnemonicParsing="false" text="Recall gatherers" />
                            <CheckBox fx:id="checkBoxActivePets" maxWidth="Infinity"
                                      mnemonicParsing="false" text="Pets" />
                        </VBox>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
