<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.*?>
<?import dev.frostguard.app.shared.UtcDateTimeEditor?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="task-page-scroll">
            <VBox spacing="16" styleClass="task-page-root" maxWidth="Infinity">

                <HBox alignment="TOP_LEFT" spacing="14">
                    <VBox fx:id="sectionLeader" prefWidth="200.0" styleClass="content-card, bear-role-section" HBox.hgrow="ALWAYS">
                        <HBox fx:id="headerLeader" alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10"
                              styleClass="header-blue">
                            <RadioButton fx:id="radioLeader" mnemonicParsing="false" text="LEADER"
                                         styleClass="bear-role-pick" />
                            <Label fx:id="labelLeaderActive" styleClass="bear-role-active-badge" />
                        </HBox>
                        <VBox spacing="10" styleClass="task-section-inner">
                            <Label fx:id="labelLeaderSummary" styleClass="bear-role-summary" wrapText="true" />
                            <Label fx:id="labelLeaderBlocked" styleClass="setting-validation-message" wrapText="true"
                                   text="Turn off &quot;Start when the bear icon appears&quot; to lead." />
                            <HBox fx:id="rowOwnSquad" alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="110.0" styleClass="bear-rally-squad-label" text="Rally squad" />
                                <ComboBox fx:id="comboBoxRallyFlag" prefWidth="160.0" styleClass="bear-rally-squad" />
                            </HBox>
                            <Label styleClass="bear-join-with" text="Join with" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="110.0" styleClass="task-field-label" text="Hero squads" />
                                <CheckComboBox fx:id="checkComboBoxLeaderJoinFlag" prefWidth="140.0" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="110.0" styleClass="task-field-label" text="Troop squads" />
                                <CheckComboBox fx:id="checkComboBoxLeaderTroopFlag" prefWidth="140.0" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox fx:id="sectionJoiner" prefWidth="200.0" styleClass="content-card, bear-role-section" HBox.hgrow="ALWAYS">
                        <HBox fx:id="headerJoiner" alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10"
                              styleClass="header-blue">
                            <RadioButton fx:id="radioJoiner" mnemonicParsing="false" text="JOINER"
                                         styleClass="bear-role-pick" />
                            <Label fx:id="labelJoinerActive" styleClass="bear-role-active-badge" />
                        </HBox>
                        <VBox spacing="10" styleClass="task-section-inner">
                            <Label fx:id="labelJoinerSummary" styleClass="bear-role-summary" wrapText="true" />
                            <Label styleClass="bear-join-with" text="Join with" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="110.0" styleClass="task-field-label" text="Hero squads" />
                                <CheckComboBox fx:id="checkComboBoxJoinFlag" prefWidth="140.0" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label minWidth="110.0" styleClass="task-field-label" text="Troop squads" />
                                <CheckComboBox fx:id="checkComboBoxTroopFlag" prefWidth="140.0" />
                            </HBox>
                            <CheckBox fx:id="checkBoxIconStart" mnemonicParsing="false" wrapText="true"
                                      text="Start when the bear icon appears" />
                        </VBox>
                    </VBox>
                </HBox>

                <VBox styleClass="content-card">
                    <HBox maxWidth="Infinity" styleClass="header-yellow">
                        <CheckBox fx:id="checkBoxEnableBearTrap" mnemonicParsing="false"
                                  style="-fx-font-size: 15px; -fx-font-weight: bold;"
                                  text="Auto bear" />
                    </HBox>
                    <VBox spacing="10" styleClass="task-section-inner">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="190.0" styleClass="task-field-label" text="Trap" />
                            <ComboBox fx:id="comboBoxTrapNumber" prefWidth="100.0" />
                        </HBox>
                        <VBox spacing="4">
                            <Label styleClass="task-field-label" text="Bear start (UTC)" />
                            <UtcDateTimeEditor fx:id="timerDateTimeEditor" />
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="190.0" styleClass="task-field-label" text="Get ready (minutes before)" />
                            <TextField fx:id="textFieldPreparationTime" prefWidth="100.0" promptText="15" />
                        </HBox>
                        <Label styleClass="task-card-description" wrapText="true"
                               text="Stops auto-join, and recalls gatherers if ticked, this many minutes before the bear." />
                        <Label fx:id="labelPreparationTimeError" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label minWidth="190.0" styleClass="task-field-label" text="During the bear" />
                            <ComboBox fx:id="comboBoxGuard" prefWidth="400.0" />
                        </HBox>
                    </VBox>
                </VBox>

                <VBox styleClass="content-card">
                    <HBox maxWidth="Infinity" styleClass="header-neutral">
                        <Label text="Both roles" />
                    </HBox>
                    <VBox spacing="10" styleClass="task-section-inner">
                        <CheckBox fx:id="checkBoxEnableJoin" mnemonicParsing="false" text="Join rallies" />
                        <Label fx:id="labelJoinError" styleClass="setting-validation-message"
                               text="Pick a Hero squad to join rallies." wrapText="true" />
                        <CheckBox fx:id="checkBoxRecallTroops" maxWidth="Infinity"
                                  mnemonicParsing="false" text="Recall gatherers" />
                        <CheckBox fx:id="checkBoxActivePets" maxWidth="Infinity"
                                  mnemonicParsing="false" text="Use pet skills" />
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
