<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>

<!-- Statistics — top: what the bot EARNED over time (telemetry); below: task run detail -->
<BorderPane fx:id="statisticsRoot" maxHeight="Infinity" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">


    <!-- Main content (scrolls — the earnings section + charts + detail can run long) -->
    <center>
        <!-- Resources (what the bot earned) and Alliance Spend (what the alliance bought) are
             separate tabs: one is this account's own telemetry, the other other players' purchases. -->
        <TabPane fx:id="tabsStatistics" tabClosingPolicy="UNAVAILABLE" styleClass="horizontal-tab-pane">
            <Tab text="Overview">
                <VBox>
                    <VBox spacing="6" style="-fx-padding: 10 16 6 16;">
                        <HBox fx:id="windowButtons" spacing="2" styleClass="window-seg" />
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="lblWindow" styleClass="stat-window-label" wrapText="true"
                                   maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnRefresh" mnemonicParsing="false" minWidth="-Infinity"
                                    onAction="#handleRefresh" styleClass="action-button-timeline" text="Refresh" />
                            <Button fx:id="btnReset" mnemonicParsing="false" minWidth="-Infinity"
                                    onAction="#handleReset" styleClass="action-button-clear" text="Reset Statistics" />
                        </HBox>
                    </VBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox spacing="10" style="-fx-padding: 0 16 16 16;">

                            <Label fx:id="lblEarningsEmpty" styleClass="label-muted" wrapText="true"
                                   text="Not enough telemetry yet. The bot samples every couple of hours while it runs, so a full 'last night' fills in after a night of running."
                                   visible="false" managed="false" />

                            <VBox styleClass="stat-panel" spacing="6">
                                <Label text="Speedups" styleClass="stat-panel-title" />
                                <TilePane fx:id="tileSpeedups" hgap="8" vgap="6" />
                            </VBox>
                            <VBox styleClass="stat-panel" spacing="6">
                                <Label text="Power and gems" styleClass="stat-panel-title" />
                                <TilePane fx:id="tilePowerGems" hgap="8" vgap="6" />
                            </VBox>
                            <VBox styleClass="stat-panel" spacing="6">
                                <Label text="Resources" styleClass="stat-panel-title" />
                                <TilePane fx:id="tileResources" hgap="8" vgap="6" />
                            </VBox>
                            <VBox styleClass="stat-panel" spacing="6">
                                <Label text="Done in this window" styleClass="stat-panel-title" />
                                <TilePane fx:id="tileActivity" hgap="8" vgap="6" />
                                <Label fx:id="lblActivityHint" styleClass="label-muted" wrapText="true"
                                       visible="false" managed="false" />
                            </VBox>

                            <!-- ================= TASK RUN DETAIL (secondary) ================= -->
                            <TitledPane fx:id="taskRunDetailPane" text="Task run detail" expanded="false" visible="false" managed="false" styleClass="stat-titled-pane">
                                <VBox spacing="10">

                                    <!-- Summary Cards -->
                                    <HBox fx:id="hboxSummaryCards" spacing="15" alignment="CENTER" />

                                    <Separator style="-fx-opacity: 0.25;" />

                                    <!-- Task Statistics Table -->
                                    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
                                        <VBox style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
                                            <TableView fx:id="tableTasks" minHeight="240.0" prefHeight="360.0"
                                                       VBox.vgrow="ALWAYS">
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                                <columns>
                                                    <TableColumn fx:id="colTaskName" prefWidth="200.0" text="Task Name" />
                                                    <TableColumn fx:id="colRuns" prefWidth="80.0" text="Runs" />
                                                    <TableColumn fx:id="colAvgTime" prefWidth="120.0" text="Avg Time (s)" />
                                                    <TableColumn fx:id="colTotalTime" prefWidth="120.0" text="Total Time (s)" />
                                                    <TableColumn fx:id="colAvgOcr" prefWidth="100.0" text="Avg OCR Fail" />
                                                    <TableColumn fx:id="colAvgImg" prefWidth="100.0" text="Avg Img Fail" />
                                                    <TableColumn fx:id="colLastRun" prefWidth="150.0" text="Last Run" />
                                                </columns>
                                            </TableView>
                                        </VBox>
                                    </VBox>

                                    <Separator style="-fx-opacity: 0.25;" />

                                    <!-- Activity Counters -->
                                    <VBox styleClass="content-card">
                                        <HBox maxWidth="Infinity" styleClass="header-yellow">
                                            <Label text="Activity Counters" />
                                        </HBox>
                                        <VBox styleClass="task-section-inner">
                                            <VBox fx:id="vboxCounterSections" spacing="10" />
                                            <Label fx:id="lblNoData" styleClass="label-muted"
                                                   text="No statistics recorded yet..." visible="false" managed="false" />
                                        </VBox>
                                    </VBox>

                                </VBox>
                            </TitledPane>

                        </VBox>
                    </ScrollPane>
                </VBox>
            </Tab>
            <Tab text="Alliance Spend">
                <fx:include source="AllianceSpendStatsLayout.fxml" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
