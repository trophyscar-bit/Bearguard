<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<!-- matt/2026-08-13: split into one tab per event, same pattern as the outer hub tabs. -->
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
    <TabPane VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity" tabClosingPolicy="UNAVAILABLE">

        <Tab text="Myriad Bazaar" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Myriad Bazaar" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxMyriadBazaar" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Automatically collect daily free rewards from Myriad Bazaar" />
                            <Separator style="-fx-opacity: 0.25;" />
                            <Label wrapText="true" style="-fx-font-style: italic;"
                                   styleClass="task-card-description"
                                   text="No additional configuration required" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Sign-in &amp; Earn" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Sign-in &amp; Earn" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxSignInEarn" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Claims the day's free reward a few minutes after each daily reset, while the calendar icon is on the City rail. Never touches the paid Epic column." />
                            <Separator style="-fx-opacity: 0.25;" />
                            <Label wrapText="true" style="-fx-font-style: italic;"
                                   styleClass="task-card-description"
                                   text="No additional configuration required" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Mergeventure" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Mergeventure" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxMergeventure" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Plays the merge board while the event's icon is on the City rail: spends Merge Energy on the wheat field, merges and unburies pieces, feeds Jessie, then claims missions and rewards. Comes back when energy recovers. Never buys energy or packs." />
                            <Separator style="-fx-opacity: 0.25;" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureBoard"
                                      text="Play the board - spend energy, merge everything, drain the storage bubble" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureUseMax"
                                      text="Use max-level pieces - coins, energy crates, chests, fruit baskets for Jessie" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureMissions"
                                      text="Claim Daily Missions" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureAtlasPath"
                                      text="Bank Atlas star cards and claim Path milestones" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureHarvest"
                                      text="Claim free Harvest Rhapsody rewards" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureCaravan"
                                      text="Spend coins in the Caravan" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxMergeventureSaveSojourner"
                                      text="Bank coins for the Sojourner Caravan (10,000, +1% troop attack) first" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Spend leftover coins in the last" styleClass="task-field-label" />
                                <TextField prefWidth="50.0" fx:id="textfieldMergeventureSpendHours" />
                                <Label text="hours of the board" styleClass="task-field-label" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Journey of Light" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Journey of Light" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxJourneyofLight" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Keeps every expedition team flying, claims the free daily Pocket Watch and milestone rewards. Never spends Pocket Watches." />
                            <Separator style="-fx-opacity: 0.25;" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxJourneyofLightAssembleCommon"
                                      text="Assemble Common - 3 Common into 1 Premium" />
                            <CheckBox mnemonicParsing="false" fx:id="checkBoxJourneyofLightAssemblePremium"
                                      text="Assemble Premium - 3 Premium into Exquisite (75%) or Dazzling (25%)" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Mercenary Event" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Mercenary Event" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxMercenaryEvent" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Automatically hunt mercenaries" />
                            <Separator style="-fx-opacity: 0.25;" />
                            <HBox spacing="10" alignment="CENTER_LEFT" fx:id="hboxMercenaryFlagSelection">
                                <Label text="Flag Selection" minWidth="100.0" styleClass="task-field-label" />
                                <ComboBox prefWidth="120.0" fx:id="comboBoxMercenaryFlag" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Hero's Mission" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Hero's Mission Event" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxHeroMission" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Call rallies on reapers to get season hero shards" />
                            <Separator style="-fx-opacity: 0.25;" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Flag Selection" minWidth="100.0" styleClass="task-field-label" />
                                <ComboBox prefWidth="120.0" fx:id="comboBoxHeroMissionFlag" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Tundra Truck" closable="false">
            <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true" styleClass="task-page-scroll">
                <VBox maxWidth="Infinity" maxHeight="Infinity" styleClass="task-page-root">
                    <VBox styleClass="content-card">
                        <HBox styleClass="header-yellow" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <CheckBox text="Tundra Truck Event" style="-fx-font-weight: bold;"
                                      mnemonicParsing="false" fx:id="checkBoxTundraEvent" />
                        </HBox>
                        <VBox styleClass="task-section-inner">
                            <Label wrapText="true" styleClass="task-card-description"
                                   text="Automates truck refreshes and selections • Set activation time to run at specific hour" />
                            <Separator style="-fx-opacity: 0.25;" />
                            <GridPane vgap="10" hgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                </rowConstraints>
                                <CheckBox text="Use gems for refresh" mnemonicParsing="false"
                                          fx:id="checkBoxTundraUseGems"
                                          GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <CheckBox text="Go only for SSR trucks" mnemonicParsing="false"
                                          fx:id="checkBoxTundraSSR"
                                          GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <CheckBox text="Use activation time" mnemonicParsing="false"
                                          fx:id="checkBoxTundraEventActivationHour"
                                          GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            </GridPane>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Activation time (UTC)" minWidth="140.0"
                                       styleClass="task-field-label" />
                                <TextField promptText="HH:mm" prefWidth="80.0"
                                           fx:id="textfieldTundraActivationHour" />
                            </HBox>
                            <Label text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #ff4444;"
                                   fx:id="labelDateTimeError" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>
