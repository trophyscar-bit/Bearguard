<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Chat Capture — sidebar panel; controller is injected programmatically by
     LauncherLayoutController.initializeModules(), same as every other panel
     in this list. -->
<StackPane maxHeight="Infinity" maxWidth="Infinity"
           HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="task-page-scroll">
        <VBox spacing="14" styleClass="task-page-root" maxWidth="Infinity">

            <VBox maxWidth="Infinity" styleClass="content-card">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="header-yellow">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: -fg-bg-app; -fx-font-size: 13px;"
                           text="Chat Capture" />
                </HBox>

                <VBox maxWidth="Infinity" spacing="10" styleClass="task-section-inner">

                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                        <CheckBox fx:id="checkBoxEnableChatCapture" mnemonicParsing="false"
                                  style="-fx-font-weight: bold;" text="Enable" />
                    </HBox>
                    <Label styleClass="task-card-description" wrapText="true"
                           text="Screenshots World, Alliance, and Personal chat on a schedule and saves them for the dashboard. Repeat runs only save messages that are actually new - it diffs against what it already captured rather than re-saving the same history every cycle." />

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Check every" minWidth="140" />
                        <ComboBox fx:id="comboBoxChatFrequency" prefWidth="150.0" />
                    </HBox>

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                        <CheckBox fx:id="checkBoxChatReconcile" mnemonicParsing="false"
                                  style="-fx-font-weight: bold;" text="Nightly catch-up" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="Once a day, the first check at or after the time below scrolls for longer and reads every screen instead of stopping at the first message it already has, then files whatever was missed - a stretch when the bot was paused, for instance. The game gives messages no time, so recovered ones are placed between the messages stored either side of them and marked as estimates. If the scroll ends before it reaches messages it already had, the log says the gap was not bridged. The bot has to be running: if it was paused at that time, the first check after it resumes does the catch-up instead." />
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Run at" minWidth="140" />
                        <TextField fx:id="textFieldChatReconcileTime" prefWidth="90.0" />
                    </HBox>
                    <Label fx:id="labelChatReconcileTimeError" maxWidth="Infinity" wrapText="true" />
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Scroll for" minWidth="140" />
                        <ComboBox fx:id="comboBoxChatReconcileMinutes" prefWidth="150.0" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="Per channel. An ordinary check scrolls two and a half minutes, about seventy-five screens. Measured, that is about 1.6 messages a screen, so five minutes reaches back roughly six hours of Alliance chat and nine of World; a gap of days needs far longer. The catch-up holds the emulator for twice this (World, then Alliance) and reading afterwards takes longer still, so pick an hour you are not using it." />

                    <Separator style="-fx-opacity: 0.25;" />

                    <Label styleClass="task-field-label" text="Channels" minWidth="140" />
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <CheckBox fx:id="checkBoxChatIncludeWorld" mnemonicParsing="false" text="World" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <CheckBox fx:id="checkBoxChatIncludeAlliance" mnemonicParsing="false" text="Alliance" />
                    </HBox>

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <CheckBox fx:id="checkBoxChatFilterNoise" mnemonicParsing="false"
                                  text="Filter out emote/sticker-only messages" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="Applied during capture, not just tagged for later: a message with no letters or digits in it (just an emoji or sticker) is dropped before saving." />

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Show times in" minWidth="140" />
                        <ComboBox fx:id="comboBoxChatTimezone" prefWidth="260.0" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="Changes how times are displayed in the Chat and Digest tabs, nothing else. Messages are stored as exact moments, so switching this re-labels what is already captured rather than re-reading anything - useful for reading an alliance spread across timezones in the hours they actually keep." />

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Show in Chat tab" minWidth="140" />
                        <ComboBox fx:id="comboBoxChatViewMessages" prefWidth="220.0" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="How many of the most recent messages the Chat tab draws. This is a limit on the panel, not on the transcript - nothing is deleted, the older messages are simply not built. Raise it to scroll further back; lower it if the tab feels slow to open." />

                    <Separator style="-fx-opacity: 0.25;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="task-field-label" text="Keep screens" minWidth="140" />
                        <ComboBox fx:id="comboBoxChatFrameCache" prefWidth="220.0" />
                    </HBox>
                    <Label styleClass="task-card-note" wrapText="true"
                           text="Screens are read and thrown away, so nothing is written to disk unless you set a figure here. Keeping some lets a capture be read again later without waiting for the alliance to repeat itself - useful if the reader misses something and you want it retried. These are pictures of your chat: the oldest are deleted once the figure is reached." />

                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</StackPane>
